{
  "name": "pi-cyber-ui",
  "version": "0.1.31",
  "description": "Standalone Pi UI package with a cyber-inspired theme, custom editor, footer, and lightweight working indicator.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "themes",
    "extensions",
    "README.md"
  ],
  "scripts": {
    "test": "node test/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "pi": {
    "themes": [
      "./themes"
    ],
    "extensions": [
      "./extensions/pi-cyber-ui/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.82.1",
    "@earendil-works/pi-coding-agent": ">=0.82.1",
    "@earendil-works/pi-tui": ">=0.82.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "typescript": "^5.7.3"
  }
}
