{
  "name": "pi-cyber-ui",
  "version": "0.1.33",
  "description": "Cyber-inspired Pi theme + UI: silver prompt, neon tool gutter, compact footer, working HUD.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/22GNUs/pi-cyber-ui"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "themes",
    "extensions",
    "docs",
    "design",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/22GNUs/pi-cyber-ui/main/docs/screenshot.jpg",
    "themes": [
      "./themes"
    ],
    "extensions": [
      "./extensions/pi-cyber-ui/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.82.1",
    "@earendil-works/pi-coding-agent": ">=0.82.1",
    "@earendil-works/pi-tui": ">=0.82.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "typescript": "^5.7.3"
  }
}
